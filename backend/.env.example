# Parallax backend configuration. Copy to backend/.env locally, or set these
# as Railway service variables. Names only — never commit real values.
# `python deploy_check.py` reports which are missing.

# ── Where data lives (backend/paths.py) ─────────────────────────────────────
# The persistent volume. On Railway, mount the volume at /app/data and set
# DATA_DIR to the same path. Unset locally: backend/data.
DATA_DIR=

# ── Required ────────────────────────────────────────────────────────────────
JWT_SECRET=                 # signs logins; one value shared by web + worker
OPENAI_API_KEY=             # enrichment, voice, asset briefs (openai_gate.py)
ANTHROPIC_API_KEY=          # briefings and decks only
SEED_TEMP_PASSWORD=         # password for users seeded into an EMPTY database

# ── Sources ─────────────────────────────────────────────────────────────────
AISSTREAM_API_KEY=          # live vessels
TELEGRAM_API_ID=            # ground footage (then: python telegram_ingest.py login)
TELEGRAM_API_HASH=
FIRMS_MAP_KEY=              # NASA fires
GFW_TOKEN=                  # Global Fishing Watch vessel owners
COPERNICUS_CLIENT_ID=       # Sentinel imagery
COPERNICUS_CLIENT_SECRET=
OPENAIP_KEY=                # airspace

# ── Model spend and use ─────────────────────────────────────────────────────
HW_OPENAI_PURPOSES=         # allowlist of OpenAI uses (openai_gate.py)
HW_LLM_PURPOSES=            # allowlist of Claude uses (llm_gate.py)
OPENAI_BUDGET_USD=11.0      # monthly cap
OPENAI_MODEL=
OPENAI_ASSET_MODEL=gpt-4o   # asset briefs
CLAUDE_BUDGET_USD=10.0

# ── Processes (start.sh) ────────────────────────────────────────────────────
PARALLAX_RUN_WORKER=true    # a second process runs the ingest loops
# PORT is set by Railway.

# ── Media ───────────────────────────────────────────────────────────────────
TELEGRAM_VIDEO_STORE=temp   # 'volume' on the server: keep footage on the volume
TELEGRAM_VIDEO_KEEP_DAYS=90 # with 'volume'
TELEGRAM_VIDEO_KEEP_MB=20000

# ── Feature switches (defaults are the tested ones) ─────────────────────────
SENTINEL_IMAGERY_ENABLED=true
AIS_LOITERING_ENABLED=false         # froze the event loop; leave off
TRACK_DENSITY_CLEANUP_ENABLED=true  # off let one table reach 10.7 GB
ALERT_BACKFILL_ENABLED=0
